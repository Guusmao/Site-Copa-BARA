{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/organizacao",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "regions": [
    "gru1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "copa-bara.vercel.app"
        }
      ],
      "destination": "https://jesus-cup.vercel.app/:path*",
      "permanent": true
    }
  ]
}
